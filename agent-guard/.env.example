# Internal token used by both LiteLLM (x-api-key) and direct callers (Bearer).
AGENT_GUARD_TOKEN=dev-agent-guard-token

# Response metadata and rule-set version.
AGENT_GUARD_POLICY_VERSION=2026-09-21.1

# Input limits protect the synchronous regex path.
AGENT_GUARD_MAX_TEXTS=100
AGENT_GUARD_MAX_TEXT_CHARS=50000
AGENT_GUARD_MAX_TOTAL_CHARS=200000
