# Client-facing LiteLLM Proxy key.
# LITELLM_MASTER_KEY=sk-local-dev

# Upstream provider key referenced by config.yaml.
OPENAI_API_KEY=replace-me

# agent-guard service root. LiteLLM appends
# /beta/litellm_basic_guardrail_api automatically.
AGENT_GUARD_BASE_URL=http://127.0.0.1:8001
AGENT_GUARD_TOKEN=dev-agent-guard-token
